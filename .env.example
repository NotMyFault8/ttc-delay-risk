POSTGRES_PASSWORD=replace-with-a-local-alphanumeric-password
AIRFLOW_POSTGRES_PASSWORD=replace-with-another-local-alphanumeric-password
# Generate two independent values with: openssl rand -hex 32
AIRFLOW_API_SECRET_KEY=replace-with-a-long-random-api-secret
AIRFLOW_JWT_SECRET=replace-with-another-long-random-jwt-secret
# Set only when enabling the daily publisher; see docs/operations.md.
TTC_PUBLISH_DATABASE_URL=
